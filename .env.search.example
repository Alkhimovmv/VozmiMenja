# Copy this file to .env.search.local. Never commit the local file or credentials.
SITE_URL=https://vozmimenya.ru/
SITEMAP_URL=https://vozmimenya.ru/sitemap.xml
SEARCH_EXPORT_DAYS=90

# Yandex Webmaster: OAuth token with access to webmaster API.
YANDEX_WEBMASTER_TOKEN=
YANDEX_RECRAWL_MAX_URLS=20

# Google Search Console. An API key alone cannot access private Search Console data.
# Recommended: a service-account JSON file whose client_email has access to the property.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/google-service-account.json
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:vozmimenya.ru

# Optional quota-project API key; OAuth/service-account authorization is still required.
GOOGLE_API_KEY=
