{
  "name": "equipment-rental",
  "version": "1.0.0",
  "description": "Площадка аренды оборудования",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run sitemap --workspace=server && npm run build --workspace=client && npm run build --workspace=server",
    "smoke:public": "npm run smoke:public --workspace=server",
    "smoke:public:prod": "npm run smoke:public:prod --workspace=server",
    "smoke:seo": "npm run smoke:seo --workspace=server",
    "smoke:seo:prod": "npm run smoke:seo:prod --workspace=server",
    "wait:articles:prod": "node scripts/wait-for-seeded-articles.mjs --timeout-ms 900000 --interval-ms 15000",
    "smoke:articles:prod": "node scripts/smoke-seeded-articles.mjs --attempts 12 --interval-ms 10000",
    "test": "npm run test --workspace=client && npm run test --workspace=server && npm run test:deploy && npm run test:search-console",
    "test:article-release": "node --test scripts/seeded-article-contract.test.mjs",
    "test:indexnow": "node --test scripts/indexnow.test.mjs",
    "test:search-console": "node --test scripts/search-console.test.mjs",
    "seo:console:status": "node scripts/search-console.mjs status",
    "seo:console:submit": "node scripts/search-console.mjs submit",
    "seo:console:export": "node scripts/search-console.mjs export",
    "seo:console:all": "node scripts/search-console.mjs all",
    "test:deploy": "bash scripts/test-deploy-sitemap-restore.sh",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "qs": "^6.16.0",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "^5.0.12"
    }
  }
}
