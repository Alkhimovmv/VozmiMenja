{
  "name": "equipment-rental-server",
  "version": "1.0.0",
  "description": "Backend для площадки аренды оборудования",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "sitemap": "tsx src/scripts/generate-sitemap.ts",
    "sitemap:prod": "node dist/scripts/generate-sitemap.js",
    "seed:blog-growth": "tsx src/scripts/seed-blog-growth-articles.ts",
    "seed:blog-growth:prod": "node dist/scripts/seed-blog-growth-articles.js",
    "smoke:public": "tsx src/scripts/smoke-public-urls.ts",
    "smoke:public:prod": "SMOKE_BASE_URL=https://vozmimenya.ru node dist/scripts/smoke-public-urls.js",
    "smoke:seo": "tsx src/scripts/smoke-seo.ts",
    "smoke:seo:prod": "SMOKE_BASE_URL=https://vozmimenya.ru node dist/scripts/smoke-seo.js",
    "seed": "tsx src/scripts/seed.ts",
    "reset-db": "tsx src/scripts/reset-db.ts",
    "migrate": "tsx src/scripts/migrate-pricing.ts",
    "migrate:images": "node src/scripts/migrate-image-urls.js",
    "migrate:auth": "tsx src/scripts/migrate-auth.ts",
    "repair:rental-office-links": "tsx src/scripts/repair-rental-office-equipment-links.ts",
    "repair:rental-office-links:dry": "tsx src/scripts/repair-rental-office-equipment-links.ts --dry-run"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/node-telegram-bot-api": "^0.64.11",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^2.1.0",
    "nodemailer": "^10.0.3",
    "sqlite3": "^6.0.1",
    "uuid": "^11.1.1",
    "vk-io": "^4.10.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
